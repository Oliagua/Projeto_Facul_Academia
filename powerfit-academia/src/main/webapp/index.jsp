</div>
</div>
<form id="contato-form" action="contato" method="post">
<h3>Vamos conversar?</h3>
<label>Nome<input name="nome" type="text" minlength="2" maxlength="120" autocomplete="name" required>
</label>
<label>E-mail<input name="email" type="email" maxlength="120" autocomplete="email" required>
</label>
<label>Telefone<input name="telefone" type="tel" maxlength="25" autocomplete="tel" placeholder="(11) 99999-9999" required>
</label>
<label>Mensagem<textarea name="mensagem" rows="4" maxlength="2000" required></textarea>
</label>
<button class="btn btn-primary" type="submit">Validar contato</button>
<p id="form-msg" class="form-msg" role="status" aria-live="polite">
</p>
</form>
